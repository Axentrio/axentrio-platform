{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**"
  ],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "complexity": ["warn", { "max": 20 }]
  }
}
