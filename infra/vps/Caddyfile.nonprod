# HTTP-01 via Let's Encrypt. Domain DNS stays on Netlify (NS1).
# No Cloudflare token. Port 80 must stay open for the ACME challenge.
api.staging.axentrio.com {
	reverse_proxy staging-api:3000 {
		health_uri /health
		health_interval 5s
		health_timeout 2s
	}
}

api.dev.axentrio.com {
	reverse_proxy dev-api:3000 {
		health_uri /health
		health_interval 5s
		health_timeout 2s
	}
}

staging.axentrio.com {
	root * /srv/portal-staging
	encode gzip
	try_files {path} /index.html
	file_server
	header /index.html Cache-Control "no-cache"
	header /meta-oauth-complete.html Cache-Control "no-cache"
}

dev.axentrio.com {
	root * /srv/portal-dev
	encode gzip
	try_files {path} /index.html
	file_server
	header /index.html Cache-Control "no-cache"
	header /meta-oauth-complete.html Cache-Control "no-cache"
}

app.staging.axentrio.com {
	redir https://staging.axentrio.com{uri} permanent
}

app.dev.axentrio.com {
	redir https://dev.axentrio.com{uri} permanent
}
