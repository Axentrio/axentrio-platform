# === Required (auto-provided by Railway) ===
# DATABASE_URL=postgresql://...  (from Railway PostgreSQL plugin)
# REDIS_URL=redis://...          (from Railway Redis plugin)
# PORT=3000                      (assigned by Railway)

# === Required (set manually) ===
NODE_ENV=production
API_URL=https://your-api.up.railway.app
JWT_SECRET=                      # openssl rand -base64 32
JWT_REFRESH_SECRET=              # openssl rand -base64 32
ENCRYPTION_KEY=                  # openssl rand -base64 32
WIDGET_API_KEY=                  # openssl rand -base64 24
CORS_ORIGIN=https://your-portal.up.railway.app

# === Database (only needed if not using DATABASE_URL) ===
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=chatbot_platform
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false

# === Redis (only needed if not using REDIS_URL) ===
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# === JWT ===
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# === AWS S3 (required for file uploads) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=

# === Optional S3 settings ===
# S3_ENDPOINT=                   # For S3-compatible services
# S3_FORCE_PATH_STYLE=false
# S3_SIGNED_URL_EXPIRY=900
# CDN_URL=                       # If not set, files served via S3 signed URLs

# === Stripe / Billing (required outside of NODE_ENV=test) ===
# In NODE_ENV=production, boot fails fast if any of these four are missing
# or empty. In development/staging it warns and degrades billing endpoints.
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret. For local dev, run:
#   stripe listen --forward-to localhost:3002/api/v1/webhooks/billing/stripe
# and paste the printed `whsec_...` here. For Railway/prod, create a
# webhook endpoint in Dashboard → Developers → Webhooks and copy its
# signing secret (different from the CLI one).
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring Price IDs from https://dashboard.stripe.com/test/products
# Essential = €49.99/mo, Pro = €99.99/mo, Enterprise = €149/mo (EUR, ex-VAT).
# One Price per plan. Each price ID is `price_...` (NOT the product `prod_...`).
STRIPE_PRICE_ESSENTIAL=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx
# Forward-trial is Stripe-native via `subscription_data.trial_period_days: 14`
# in the Checkout creation call — no env var needed; no local trial-expiry job.
# ONBOARDING_PRO_TRIAL=false       # Experimental: revert new orgs to Free.

# === Billit / Peppol (legal invoices) ===
# PartyID + ApiKey for Axentrio's own Billit company. Missing values store
# a draft for Super Admin retry; they do not block boot.
# Sandbox: https://api.sandbox.billit.be  Production: https://api.billit.be
# When you set these keys, also add Stripe webhook events (Dashboard login
# required): charge.refunded, charge.dispute.closed. See
# docs/billing-stripe-setup-runbook.md
# "When you turn on Billit".
BILLIT_API_URL=https://api.sandbox.billit.be
BILLIT_API_KEY=
BILLIT_PARTY_ID=

# === Optional ===
# N8N_WEBHOOK_URL=               # If not set, message forwarding disabled
# N8N_DEFAULT_WEBHOOK_URL=http://localhost:5678/webhook/chatbot-platform
# RAG_INTERNAL_SECRET=change-me-in-production
# N8N_INBOUND_SECRET=change-me-in-production
# CLAMAV_HOST=                   # If not set, virus scanning skipped
# CLAMAV_PORT=3310
# LOG_LEVEL=info
# LOG_FORMAT=combined
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
# LLM_DAILY_LIMIT_PER_TENANT=5000   # env fallback if entitlements lookup fails

# Travel-time aware scheduling (ADR-0014). ONE platform key for Geocoding + Routes.
# Absent is a supported state and the EMERGENCY STOP: with no key the whole feature is
# inert platform-wide and the scheduler behaves exactly as it did before travel time
# existed. The key must sit on an upgraded, NON-TRIAL Google billing account before any
# tenant is entitled — a lapsed trial is a permanent, silent degradation, not a clean
# failure.
# GOOGLE_MAPS_API_KEY=
# Billable Google units per tenant per calendar month. A blast-radius limit, not a budget:
# one runaway conversation must not spend the platform's whole Maps quota. Exhausting it
# degrades (haversine proofs only), it does not refuse bookings. 0 or less = uncapped.
# TRAVEL_MONTHLY_ELEMENT_CAP=5000

# Composable templates: bot skills = bound template skills ∩ entitlements (no template → KB-only).
# If unset, the gate is a no-op and every entitled tool reaches the LLM regardless of template.
COMPOSABLE_TEMPLATES_ENABLED=true

# === Google Drive knowledge import (separate OAuth client from Calendar) ===
# Register a NEW OAuth client on the existing Google Cloud project. Do not reuse
# GOOGLE_CLIENT_ID. Redirect URI must be:
#   {API_URL}/api/v1/knowledge/storage/google/callback
# Enable the Google Picker API and create a browser API key with HTTP referrer
# restriction to the portal origin.
# GOOGLE_STORAGE_CLIENT_ID=
# GOOGLE_STORAGE_CLIENT_SECRET=
# GOOGLE_STORAGE_REDIRECT_URI=
# STORAGE_OAUTH_STATE_SECRET=          # openssl rand -base64 32
# GOOGLE_PICKER_API_KEY=

# === OneDrive knowledge import (separate Azure app from Calendar) ===
# Redirect: {API_URL}/api/v1/knowledge/storage/onedrive/callback
# MICROSOFT_STORAGE_CLIENT_ID=
# MICROSOFT_STORAGE_CLIENT_SECRET=
# MICROSOFT_STORAGE_REDIRECT_URI=
