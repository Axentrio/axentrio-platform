# API env: copy to /opt/axentrio/staging.env
# Build from this file. Do not copy Railway chatbot-api (prod) values.
# Generate JWT/encryption/widget secrets per env. Clerk + Stripe must be
# test/sandbox. Isolated DB, Redis, S3 bucket, and webhook secrets.
#
# Also write /opt/axentrio/.env on this box for Compose interpolation only:
#   REDIS_PASSWORD=
#   POSTGRES_PASSWORD=
#
# NEVER set WEBHOOK_URL or N8N_WEBHOOK_URL.
# Stripe webhook: https://api.staging.axentrio.com/api/v1/webhooks/billing/stripe

AGENT_BURST_DEBOUNCE_MS=
ALLOWED_FILE_TYPES=
ANTHROPIC_API_KEY=
API_URL=https://api.staging.axentrio.com
API_VERSION=
AUDIT_RETENTION_DAYS=
AWS_ACCESS_KEY_ID=
AWS_REGION=auto
AWS_S3_BUCKET=
AWS_SECRET_ACCESS_KEY=
