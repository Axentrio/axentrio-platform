TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/chatbot_test
JWT_SECRET=test-jwt-secret-for-testing-only
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
NODE_ENV=test
CLERK_SECRET_KEY=test_clerk_key
CLERK_WEBHOOK_SECRET=test_webhook_secret
SUPER_ADMIN_EMAILS=test@example.com
# Billing — set so PLANS catalog can reverse-lookup price IDs in tests.
# (Boot fail-fast for these is skipped when NODE_ENV=test.)
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_test_dummy
STRIPE_PRICE_ESSENTIAL=price_test_essential
STRIPE_PRICE_PRO=price_test_pro

# Booking manage-link / Meta OAuth token signing (booking-token.ts requires this).
META_OAUTH_JWT_SECRET=test-meta-oauth-jwt-secret-32chars-min

# Real Redis for the tests that assert cross-instance coordination (travel degradation
# monitor: incident latch, probe lease, success-vs-failure ordering). Started by
# docker-compose.test.yml on 6380 so it cannot collide with a local dev Redis on 6379.
# CI injects its own TEST_REDIS_URL, so this must not override there.
TEST_REDIS_URL=redis://localhost:6380
